  "gradeScale": [
    {
      "grade": "A",
      "min": 90,
      "max": 100,
      "summary": "반복적으로 매우 안정적이며 별도 보정 없이 바로 실행 가능"
    },
    {
      "grade": "B",
      "min": 75,
      "max": 89,
      "summary": "대체로 실무 사용 가능하나 일부 보완 필요"
    },
    {
      "grade": "C",
      "min": 60,
      "max": 74,
      "summary": "기본 요건은 충족하지만 일관성과 완성도가 부족"
    },
    {
      "grade": "D",
      "min": 40,
      "max": 59,
      "summary": "단서는 있으나 실사용에는 리스크가 큼"
