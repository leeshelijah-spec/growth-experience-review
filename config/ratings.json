          "maxGrade": "C",
          "whenMissingAnyOf": [
            "decision_basis"
          ],
          "reason": "판단 근거가 없어 C 상한 적용"
        }
      ],
      "floorRules": [
        {
          "minGrade": "B",
          "whenAllOf": [
            "problem_identified",
            "alternatives_present",
            "decision_basis"
          ],
          "scope": "same_session",
          "reason": "문제·대안·판단 근거가 함께 제시되어 최소 B 보정"
        }
      ],
      "gradeCriteria": {
        "A": "막힘 상황에서 원인 정리와 대안 전환이 반복적으로 실행됨",
        "B": "문제 발생 시 우회와 재설정이 가능하며 방향 수정도 무리 없이 수행됨",
        "C": "문제 인지는 가능하나 대안 전환의 속도와 일관성이 부족함",
        "D": "문제는 보이지만 우회 전략으로 이어지지 않음",
        "E": "막힘 상황에서 재설정 또는 대안 탐색 행동이 거의 없음"
      }
    },
    {
      "key": "retrospective_continuity",
      "name": "회고 지속성",
      "description": "주간 단위로 회고와 개선 이력이 이어지고 있는가",
      "gradeCriteria": {
        "A": "주간 회고가 규칙적으로 축적되고 개선 항목이 다음 실행으로 연결됨",
        "B": "주간 회고 흐름이 유지되고 개선 사항이 추적 가능한 형태로 남음",
        "C": "회고 시도는 있으나 주간 이력과 후속 실행의 연결이 불안정함",
        "D": "회고 흔적은 있으나 주간 루틴으로 정착되지 않음",
        "E": "회고 및 개선 추적 행동이 거의 관찰되지 않음"
      }
