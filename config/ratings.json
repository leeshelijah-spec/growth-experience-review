        {
          "key": "cause_hypothesis",
          "label": "원인 가설"
        },
        {
          "key": "alternatives_present",
          "label": "대안 제시"
        },
        {
          "key": "decision_basis",
          "label": "판단 근거"
        }
      ],
      "requiredForA": [
        "problem_identified",
        "cause_hypothesis",
        "alternatives_present",
        "decision_basis"
      ],
      "requiredForB": [
        "problem_identified",
        "alternatives_present",
        "decision_basis"
